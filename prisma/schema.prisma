// ==========================================
// AYAAN MOBILITY - MASTER DATABASE SCHEMA
// Provider: PostgreSQL
// ORM: Prisma ORM
//
// Schema-fix pass (this revision) resolves the 6 issues
// flagged by Ace/Fable review after Step 1/2:
//   1. Money fields: Float -> Decimal(12,2) (avoid float rounding drift)
//   2. DutyLog.agreementId FK added (traceability to the exact
//      agreement/rate version in effect at time of duty)
//   3. User.companyId added for CLIENT_USER tenant isolation
//   4. Invoice: @@unique([companyId, month, year]) added
//   5. DutyLog.idempotencyKey added for Ayaan Go offline retry safety
//   6. isFriday()/holiday-detection timezone (Asia/Dhaka) fix is an
//      application-code concern (Step 3 server action), not a schema
//      change -- no field added here for it, noted for Step 3.
// ==========================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------
// ENUMS (System Options & States)
// ------------------------------------------

enum Role {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  ACCOUNTS_ADMIN
  CLIENT_USER
  CAR_OWNER
  DRIVER
}

enum VehicleCategory {
  SEDAN_AXIO
  SEDAN_PREMIO_ALLION
  NOAH_HIACE
  NISSAN_XTRAIL
  TOYOTA_HARRIER
  PRADO
  LAND_CRUISER_PRADO
  CIVILIAN_COASTER
  BMW_MERCEDES_SEDAN
  RANGE_ROVER_BMW_MERCEDES_SUV
  AMBULANCE
  AC_BUS
  CUSTOM
}

enum FuelType {
  CNG
  LPG
  OCTANE
  PETROL
  DIESEL
  OCTANE_AND_CNG
  OCTANE_AND_LPG
}

enum RentalType {
  DAILY
  WEEKLY
  MONTHLY_CORPORATE
}

enum DutyStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EDITED_BY_ADMIN
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  ACTIVE
  IN_DUTY
  MAINTENANCE
  INACTIVE
}

enum LanguagePreference {
  BANGLA
  ENGLISH
}

// ------------------------------------------
// 1. USER & AUTHENTICATION MODULE
// ------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  phone         String    @unique
  email         String?   @unique
  password      String
  role          Role      @default(DRIVER)
  isActive      Boolean   @default(true)
  language      LanguagePreference @default(BANGLA)

  // --- Fix #3: tenant isolation for CLIENT_USER ---
  // Nullable because only CLIENT_USER rows need it; app layer must
  // enforce that every CLIENT_USER row has this set on creation.
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profiles (One-to-One)
  carOwnerProfile CarOwnerProfile?
  driverProfile   DriverProfile?

  // Audit & Logs
  auditLogs     AuditLog[]
  createdLogs   DutyLog[] @relation("ApprovedByAdmin")

  @@index([phone, email, role])
  @@index([companyId])
}

model CarOwnerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nidNumber       String?
  bankName        String?
  accountNumber   String?
  bkashNumber     String?
  vehicles        Vehicle[]
  payouts         OwnerPayout[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DriverProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String   @unique
  licenseExpiry   DateTime
  licenseImage    String?  // Cloud Storage URL
  photoUrl        String?
  nidNumber       String?

  // Driver Wallet & Current State
  walletBalance   Decimal  @default(0) @db.Decimal(12, 2)
  assignedVehicle Vehicle? @relation("CurrentDriver")
  dutyLogs        DutyLog[]
  expenseClaims   ExpenseClaim[]
  emergencyAlerts EmergencyAlert[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Company {
  id            String      @id @default(uuid())
  name          String
  contactPerson String
  phone         String
  email         String?
  address       String?
  agreements    Agreement[]
  dutyLogs      DutyLog[]
  invoices      Invoice[]

  // --- Fix #3: back-relation for tenant-scoped client users ---
  clientUsers   User[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ------------------------------------------
// 2. FLEET & ASSET MANAGEMENT
// ------------------------------------------

model Vehicle {
  id                String          @id @default(uuid())
  regNumber         String          @unique // e.g. "Dhaka Metro GA-11-2233"
  category          VehicleCategory
  modelYear         Int
  fuelType          FuelType
  status            VehicleStatus   @default(ACTIVE)
  carPhotoUrl       String?

  // Expiry Compliance Tracking
  taxTokenExpiry    DateTime?
  fitnessExpiry     DateTime?
  routePermitExpiry DateTime?
  insuranceExpiry   DateTime?

  // Ownership & Assignment
  carOwnerId        String
  carOwner          CarOwnerProfile @relation(fields: [carOwnerId], references: [id])

  currentDriverId   String?         @unique
  currentDriver     DriverProfile?  @relation("CurrentDriver", fields: [currentDriverId], references: [id])

  agreements        Agreement[]
  dutyLogs          DutyLog[]
  maintenances      MaintenanceLog[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ------------------------------------------
// 3. DYNAMIC CONTRACT & AGREEMENT ENGINE
// ------------------------------------------

model Agreement {
  id                    String      @id @default(uuid())
  title                 String      // Contract identifier
  companyId             String
  company               Company     @relation(fields: [companyId], references: [id])
  vehicleId             String
  vehicle               Vehicle     @relation(fields: [vehicleId], references: [id])
  rentalType            RentalType  @default(MONTHLY_CORPORATE)

  // Pricing & Rent Rules
  baseRent              Decimal     @db.Decimal(12, 2) // Monthly or Daily Rent BDT
  monthlyFuelQuotaLiters Float      @default(0.0) // e.g. 20L or 30L Free (volume, not currency)

  // Dynamic Per KM Fuel Rates (BDT)
  cngRatePerKm          Decimal     @default(10.0) @db.Decimal(12, 2)
  lpgRatePerKm          Decimal     @default(10.0) @db.Decimal(12, 2)
  octaneRatePerKm       Decimal     @default(15.0) @db.Decimal(12, 2)

  // Duty & Overtime Rules
  standardDutyHours     Int         @default(10) // e.g. 10 Hours
  overtimeRatePerHour   Decimal     @default(100.0) @db.Decimal(12, 2)
  fridayHolidayOvertime Boolean     @default(true)

  // Allowances Rules (BDT)
  lunchAllowance        Decimal     @default(200.0) @db.Decimal(12, 2)
  dinnerAllowance       Decimal     @default(150.0) @db.Decimal(12, 2)
  tourAllowancePerDay   Decimal     @default(1200.0) @db.Decimal(12, 2) // Outside Dhaka

  // Feature Toggles (Admin Configurable)
  allowTollParkingClaim Boolean     @default(true)

  // Owner Revenue Sharing / Commission (percentage, not currency)
  ownerCommissionTierPct Decimal    @default(10.0) @db.Decimal(5, 2) // 1% to 25%

  startDate             DateTime
  endDate               DateTime?
  isActive              Boolean     @default(true)

  // --- Fix #2: back-relation so DutyLog can pin the exact agreement used ---
  dutyLogs              DutyLog[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

// ------------------------------------------
// 4. DAILY DUTY LOGBOOK (Ayaan Go)
// ------------------------------------------

model DutyLog {
  id                   String       @id @default(uuid())
  date                 DateTime     @default(now())

  // Relations
  driverId             String
  driver               DriverProfile @relation(fields: [driverId], references: [id])
  vehicleId            String
  vehicle              Vehicle      @relation(fields: [vehicleId], references: [id])
  companyId            String
  company              Company      @relation(fields: [companyId], references: [id])

  // --- Fix #2: pin the exact agreement/rate version this duty was billed under ---
  agreementId          String
  agreement            Agreement    @relation(fields: [agreementId], references: [id])

  // --- Fix #5: idempotency for Ayaan Go offline submission retries ---
  // Client (PWA) generates this once per duty-close attempt; unique
  // constraint means a retried sync can never create a duplicate log.
  idempotencyKey       String?      @unique

  // Duty Start (Odometer & Location)
  startTime            DateTime
  startOdometer        Float
  startOdometerImg     String       // Odometer Photo URL
  startLocation        String?

  // Duty End (Odometer, Location & Notes)
  endTime              DateTime?
  endOdometer          Float?
  endOdometerImg       String?      // End Odometer Photo URL
  endLocation          String?
  routeNotes           String?      // Destination summary

  // Calculations (Generated by Backend /lib/calculator.ts)
  totalKm              Float        @default(0.0)
  dutyHours            Float        @default(0.0)
  overtimeHours        Float        @default(0.0)

  fuelBill             Decimal      @default(0) @db.Decimal(12, 2)
  overtimeBill         Decimal      @default(0) @db.Decimal(12, 2)
  lunchBill            Decimal      @default(0) @db.Decimal(12, 2)
  dinnerBill           Decimal      @default(0) @db.Decimal(12, 2)
  tourAllowance        Decimal      @default(0) @db.Decimal(12, 2)
  tollParkingBill      Decimal      @default(0) @db.Decimal(12, 2)

  totalDailyBill       Decimal      @default(0) @db.Decimal(12, 2)

  // Flags
  isHoliday            Boolean      @default(false)
  isOutsideDhakaTour   Boolean      @default(false)
  status               DutyStatus   @default(APPROVED)

  // Admin Override Approval
  approvedById         String?
  approvedBy           User?        @relation("ApprovedByAdmin", fields: [approvedById], references: [id])
  adminEditNote        String?

  expenseClaims        ExpenseClaim[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([driverId, date, companyId])
  @@index([agreementId])
}

// ------------------------------------------
// 5. EXPENSE CLAIMS (Toll & Parking)
// ------------------------------------------

model ExpenseClaim {
  id           String      @id @default(uuid())
  dutyLogId    String
  dutyLog      DutyLog     @relation(fields: [dutyLogId], references: [id], onDelete: Cascade)
  driverId     String
  driver       DriverProfile @relation(fields: [driverId], references: [id])

  expenseType  String      // "TOLL", "PARKING", "OTHER"
  amount       Decimal     @db.Decimal(12, 2)
  receiptImg   String      // Digital receipt photo
  status       ClaimStatus @default(PENDING)

  createdAt    DateTime    @default(now())
}

// ------------------------------------------
// 6. FLEET MAINTENANCE LOG
// ------------------------------------------

model MaintenanceLog {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  serviceType  String   // "ENGINE_OIL", "TYRE", "REPAIR", "FITNESS_WORK"
  cost         Decimal  @db.Decimal(12, 2)
  servicedBy   String   // "CAR_OWNER" or "AYAAN_MOBILITY"
  receiptUrl   String?
  description  String?
  serviceDate  DateTime @default(now())

  createdAt    DateTime @default(now())
}

// ------------------------------------------
// 7. INVOICING & SETTLEMENT ENGINE
// ------------------------------------------

model Invoice {
  id             String    @id @default(uuid())
  invoiceNumber  String    @unique // e.g. "INV-202608-001"
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])

  month          Int       // 1 - 12
  year           Int       // e.g. 2026

  baseRentTotal  Decimal   @db.Decimal(12, 2)
  fuelTotal      Decimal   @db.Decimal(12, 2)
  overtimeTotal  Decimal   @db.Decimal(12, 2)
  allowanceTotal Decimal   @db.Decimal(12, 2)
  tollTotal      Decimal   @db.Decimal(12, 2)
  grandTotal     Decimal   @db.Decimal(12, 2)

  isPaid         Boolean   @default(false)
  pdfUrl         String?   // Generated PDF Link

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // --- Fix #4: prevent duplicate invoices for the same company/month/year ---
  @@unique([companyId, month, year])
}

model OwnerPayout {
  id             String          @id @default(uuid())
  ownerId        String
  owner          CarOwnerProfile @relation(fields: [ownerId], references: [id])
  month          Int
  year           Int

  totalGrossEarn      Decimal    @db.Decimal(12, 2)
  commissionDeducted  Decimal    @db.Decimal(12, 2) // Based on Commission Tier %
  maintenanceDeducted Decimal    @default(0) @db.Decimal(12, 2)
  netPayoutAmount     Decimal    @db.Decimal(12, 2)

  isSettled      Boolean         @default(false)
  transactionRef String?

  createdAt      DateTime        @default(now())
}

// ------------------------------------------
// 8. SAFETY, EMERGENCY & AUDIT LOGS
// ------------------------------------------

model EmergencyAlert {
  id          String        @id @default(uuid())
  driverId    String
  driver      DriverProfile @relation(fields: [driverId], references: [id])
  location    String?
  message     String        @default("SOS Breakdown Alert")
  isResolved  Boolean       @default(false)

  createdAt   DateTime      @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id])
  action      String   // "ODOMETER_OVERRIDE", "AGREEMENT_CHANGE", "BILL_EDIT"
  entityName  String   // e.g. "DutyLog"
  entityId    String
  oldValue    String?  // JSON string
  newValue    String?  // JSON string

  createdAt   DateTime @default(now())
}
