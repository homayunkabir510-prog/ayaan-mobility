// ==========================================
// AYAAN MOBILITY - MASTER DATABASE SCHEMA
// Provider: PostgreSQL
// ORM: Prisma ORM
// ==========================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------
// ENUMS (System Options & States)
// ------------------------------------------

enum Role {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  ACCOUNTS_ADMIN
  CLIENT_USER
  CAR_OWNER
  DRIVER
}

enum VehicleCategory {
  SEDAN_AXIO
  SEDAN_PREMIO_ALLION
  NOAH_HIACE
  NISSAN_XTRAIL
  TOYOTA_HARRIER
  PRADO
  LAND_CRUISER_PRADO
  CIVILIAN_COASTER
  BMW_MERCEDES_SEDAN
  RANGE_ROVER_BMW_MERCEDES_SUV
  AMBULANCE
  AC_BUS
  CUSTOM
}

enum FuelType {
  CNG
  LPG
  OCTANE
  PETROL
  DIESEL
  OCTANE_AND_CNG
  OCTANE_AND_LPG
}

enum RentalType {
  DAILY
  WEEKLY
  MONTHLY_CORPORATE
}

enum DutyStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EDITED_BY_ADMIN
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  ACTIVE
  IN_DUTY
  MAINTENANCE
  INACTIVE
}

enum LanguagePreference {
  BANGLA
  ENGLISH
}

// ------------------------------------------
// 1. USER & AUTHENTICATION MODULE
// ------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  phone         String    @unique
  email         String?   @unique
  password      String
  role          Role      @default(DRIVER)
  isActive      Boolean   @default(true)
  language      LanguagePreference @default(BANGLA)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profiles (One-to-One)
  carOwnerProfile CarOwnerProfile?
  driverProfile   DriverProfile?

  // Audit & Logs
  auditLogs     AuditLog[]
  createdLogs   DutyLog[] @relation("ApprovedByAdmin")

  @@index([phone, email, role])
}

model CarOwnerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nidNumber       String?
  bankName        String?
  accountNumber   String?
  bkashNumber     String?
  vehicles        Vehicle[]
  payouts         OwnerPayout[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DriverProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String   @unique
  licenseExpiry   DateTime
  licenseImage    String?  // Cloud Storage URL
  photoUrl        String?
  nidNumber       String?

  // Driver Wallet & Current State
  walletBalance   Float    @default(0.0)
  assignedVehicle Vehicle? @relation("CurrentDriver")
  dutyLogs        DutyLog[]
  expenseClaims   ExpenseClaim[]
  emergencyAlerts EmergencyAlert[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Company {
  id            String      @id @default(uuid())
  name          String
  contactPerson String
  phone         String
  email         String?
  address       String?
  agreements    Agreement[]
  dutyLogs      DutyLog[]
  invoices      Invoice[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ------------------------------------------
// 2. FLEET & ASSET MANAGEMENT
// ------------------------------------------

model Vehicle {
  id                String          @id @default(uuid())
  regNumber         String          @unique // e.g. "Dhaka Metro GA-11-2233"
  category          VehicleCategory
  modelYear         Int
  fuelType          FuelType
  status            VehicleStatus   @default(ACTIVE)
  carPhotoUrl       String?

  // Expiry Compliance Tracking
  taxTokenExpiry    DateTime?
  fitnessExpiry     DateTime?
  routePermitExpiry DateTime?
  insuranceExpiry   DateTime?

  // Ownership & Assignment
  carOwnerId        String
  carOwner          CarOwnerProfile @relation(fields: [carOwnerId], references: [id])

  currentDriverId   String?         @unique
  currentDriver     DriverProfile?  @relation("CurrentDriver", fields: [currentDriverId], references: [id])

  agreements        Agreement[]
  dutyLogs          DutyLog[]
  maintenances      MaintenanceLog[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ------------------------------------------
// 3. DYNAMIC CONTRACT & AGREEMENT ENGINE
// ------------------------------------------

model Agreement {
  id                    String      @id @default(uuid())
  title                 String      // Contract identifier
  companyId             String
  company               Company     @relation(fields: [companyId], references: [id])
  vehicleId             String
  vehicle               Vehicle     @relation(fields: [vehicleId], references: [id])
  rentalType            RentalType  @default(MONTHLY_CORPORATE)

  // Pricing & Rent Rules
  baseRent              Float       // Monthly or Daily Rent BDT
  monthlyFuelQuotaLiters Float     @default(0.0) // e.g. 20L or 30L Free

  // Dynamic Per KM Fuel Rates (BDT)
  cngRatePerKm          Float       @default(10.0)
  lpgRatePerKm          Float       @default(10.0)
  octaneRatePerKm       Float       @default(15.0)

  // Duty & Overtime Rules
  standardDutyHours     Int         @default(10) // e.g. 10 Hours
  overtimeRatePerHour   Float       @default(100.0)
  fridayHolidayOvertime Boolean     @default(true)

  // Allowances Rules (BDT)
  lunchAllowance        Float       @default(200.0)
  dinnerAllowance       Float       @default(150.0)
  tourAllowancePerDay   Float       @default(1200.0) // Outside Dhaka

  // Feature Toggles (Admin Configurable)
  allowTollParkingClaim Boolean     @default(true)

  // Owner Revenue Sharing / Commission
  ownerCommissionTierPct Float      @default(10.0) // 1% to 25%

  startDate             DateTime
  endDate               DateTime?
  isActive              Boolean     @default(true)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

// ------------------------------------------
// 4. DAILY DUTY LOGBOOK (Ayaan Go)
// ------------------------------------------

model DutyLog {
  id                   String       @id @default(uuid())
  date                 DateTime     @default(now())

  // Relations
  driverId             String
  driver               DriverProfile @relation(fields: [driverId], references: [id])
  vehicleId            String
  vehicle              Vehicle      @relation(fields: [vehicleId], references: [id])
  companyId            String
  company              Company      @relation(fields: [companyId], references: [id])

  // Duty Start (Odometer & Location)
  startTime            DateTime
  startOdometer        Float
  startOdometerImg     String       // Odometer Photo URL
  startLocation        String?

  // Duty End (Odometer, Location & Notes)
  endTime              DateTime?
  endOdometer          Float?
  endOdometerImg       String?      // End Odometer Photo URL
  endLocation          String?
  routeNotes           String?      // Destination summary

  // Calculations (Generated by Backend /lib/calculator.ts)
  totalKm              Float        @default(0.0)
  dutyHours            Float        @default(0.0)
  overtimeHours        Float        @default(0.0)

  fuelBill             Float        @default(0.0)
  overtimeBill         Float        @default(0.0)
  lunchBill            Float        @default(0.0)
  dinnerBill           Float        @default(0.0)
  tourAllowance        Float        @default(0.0)
  tollParkingBill      Float        @default(0.0)

  totalDailyBill       Float        @default(0.0)

  // Flags
  isHoliday            Boolean      @default(false)
  isOutsideDhakaTour   Boolean      @default(false)
  status               DutyStatus   @default(APPROVED)

  // Admin Override Approval
  approvedById         String?
  approvedBy           User?        @relation("ApprovedByAdmin", fields: [approvedById], references: [id])
  adminEditNote        String?

  expenseClaims        ExpenseClaim[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([driverId, date, companyId])
}

// ------------------------------------------
// 5. EXPENSE CLAIMS (Toll & Parking)
// ------------------------------------------

model ExpenseClaim {
  id           String      @id @default(uuid())
  dutyLogId    String
  dutyLog      DutyLog     @relation(fields: [dutyLogId], references: [id], onDelete: Cascade)
  driverId     String
  driver       DriverProfile @relation(fields: [driverId], references: [id])

  expenseType  String      // "TOLL", "PARKING", "OTHER"
  amount       Float
  receiptImg   String      // Digital receipt photo
  status       ClaimStatus @default(PENDING)

  createdAt    DateTime    @default(now())
}

// ------------------------------------------
// 6. FLEET MAINTENANCE LOG
// ------------------------------------------

model MaintenanceLog {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  serviceType  String   // "ENGINE_OIL", "TYRE", "REPAIR", "FITNESS_WORK"
  cost         Float
  servicedBy   String   // "CAR_OWNER" or "AYAAN_MOBILITY"
  receiptUrl   String?
  description  String?
  serviceDate  DateTime @default(now())

  createdAt    DateTime @default(now())
}

// ------------------------------------------
// 7. INVOICING & SETTLEMENT ENGINE
// ------------------------------------------

model Invoice {
  id             String    @id @default(uuid())
  invoiceNumber  String    @unique // e.g. "INV-202608-001"
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])

  month          Int       // 1 - 12
  year           Int       // e.g. 2026

  baseRentTotal  Float
  fuelTotal      Float
  overtimeTotal  Float
  allowanceTotal Float
  tollTotal      Float
  grandTotal     Float

  isPaid         Boolean   @default(false)
  pdfUrl         String?   // Generated PDF Link

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model OwnerPayout {
  id             String          @id @default(uuid())
  ownerId        String
  owner          CarOwnerProfile @relation(fields: [ownerId], references: [id])
  month          Int
  year           Int

  totalGrossEarn Float
  commissionDeducted Float     // Based on Commission Tier %
  maintenanceDeducted Float    @default(0.0)
  netPayoutAmount Float

  isSettled      Boolean         @default(false)
  transactionRef String?

  createdAt      DateTime        @default(now())
}

// ------------------------------------------
// 8. SAFETY, EMERGENCY & AUDIT LOGS
// ------------------------------------------

model EmergencyAlert {
  id          String        @id @default(uuid())
  driverId    String
  driver      DriverProfile @relation(fields: [driverId], references: [id])
  location    String?
  message     String        @default("SOS Breakdown Alert")
  isResolved  Boolean       @default(false)

  createdAt   DateTime      @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id])
  action      String   // "ODOMETER_OVERRIDE", "AGREEMENT_CHANGE", "BILL_EDIT"
  entityName  String   // e.g. "DutyLog"
  entityId    String
  oldValue    String?  // JSON string
  newValue    String?  // JSON string

  createdAt   DateTime @default(now())
}
