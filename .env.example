# PostgreSQL is required for all authenticated pages and Server Actions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ayaan_mobility?schema=public"
# Max PostgreSQL connections per application process; coordinate with host/pooler limits.
DATABASE_POOL_MAX="5"

# Required for phone/password JWT sessions. Generate a random secret of at least 32 bytes.
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Required to persist driver photos and receipts in a private Supabase Storage bucket.
# Keep the service-role key server-only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="ayaan-evidence"
